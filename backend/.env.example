# AI Movie Studio 2 - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# ComfyUI Configuration (Local GPU)
# =============================================================================
# Both of these already have working defaults, so leave them commented out unless
# your ComfyUI listens somewhere unusual. Under Docker Compose, uncommenting
# COMFY_URL with a 127.0.0.1 address overrides the container default and stops the
# backend from reaching ComfyUI on your host.
# COMFY_URL=http://127.0.0.1:8188
# COMFY_OUTPUT_DIR=/path/to/ComfyUI/output

# Docker Compose, only if your ComfyUI is not on the default port:
# COMFY_URL=http://host.docker.internal:8188

# =============================================================================
# Fal.ai API Key (Seedance, Minimax H3, Nano Banana, Krea)
# Get your key at: https://fal.ai/dashboard/keys
# =============================================================================
FAL_KEY=your_fal_api_key_here

# =============================================================================
# Replicate API Token (MetaAI, Fish Speech)
# Get your token at: https://replicate.com/account/api-tokens
# =============================================================================
REPLICATE_API_TOKEN=your_replicate_token_here

# =============================================================================
# Optional: OpenAI (for script parsing / LLM features)
# =============================================================================
# OPENAI_API_KEY=your_openai_key

# =============================================================================
# Future: MongoDB
# =============================================================================
# MONGODB_URI=mongodb://localhost:27017/aimoviestudio
